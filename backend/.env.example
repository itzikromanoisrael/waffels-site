PORT=3000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-domain.co.il
ALLOWED_ORIGINS=https://your-domain.co.il,https://www.your-domain.co.il
ENABLE_HSTS=true
TRUST_PROXY=true
TIME_ZONE=Asia/Jerusalem
GOOGLE_CALENDAR_ID=your-calendar-id@gmail.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
ADMIN_PASSWORD_HASH=pbkdf2:210000:replace_salt:replace_hash
ADMIN_SESSION_SECRET=replace-with-64-random-hex-chars
ADMIN_APPROVAL_CODE=replace-with-separate-approval-code
DEPOSIT_AMOUNT_ILS=150
DEPOSIT_WINDOW_MINUTES=15
BOOKING_RATE_LIMIT_WINDOW_MS=900000
BOOKING_RATE_LIMIT_MAX=8
SELF_PING_URL=https://your-domain.co.il/api/health
SELF_PING_INTERVAL_MS=600000
